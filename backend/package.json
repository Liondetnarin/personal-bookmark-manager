{
  "name": "@bookmark-manager/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
