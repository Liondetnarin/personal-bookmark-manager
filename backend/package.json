{
  "name": "@bookmark-manager/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "build": "npm run db:generate && tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:generate": "node ../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env ../node_modules/prisma/build/index.js migrate deploy",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.10.0"
  }
}
