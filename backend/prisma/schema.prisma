generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  issuer    String
  subject   String
  createdAt DateTime @default(now())
  collections Collection[]
  bookmarks Bookmark[]

  @@unique([issuer, subject])
}

model Collection {
  id        String   @id @default(uuid())
  name      String
  nameKey   String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookmarks Bookmark[]

  @@unique([id, ownerId])
  @@unique([ownerId, nameKey])
  @@index([ownerId, createdAt, id])
}

model Bookmark {
  id           String @id @default(uuid())
  url          String
  title        String
  notes        String?
  ownerId      String
  owner        User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, createdAt, id])
  @@index([ownerId, collectionId, createdAt, id])
}
